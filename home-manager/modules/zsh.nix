# home-manager/modules/zsh.nix
#
# Zsh shell configuration. Interactive shell helpers live in
# ../scripts/zsh-integration.zsh so this module stays focused on Home Manager
# options.
{
  config,
  lib,
  pkgs,
  userConfig,
  ...
}:
let
  profile = config.homelab.profile;
  bitwardenAgent = config.programs.ssh.custom.bitwardenAgent;
  # Bitwarden binds the env var value verbatim, so expand a leading "~" to $HOME.
  bitwardenSocketEnv =
    if lib.hasPrefix "~/" bitwardenAgent.socketPath then
      "$HOME/${lib.removePrefix "~/" bitwardenAgent.socketPath}"
    else
      bitwardenAgent.socketPath;

  # Pre-generate and wordcode-compile (.zwc) static shell integrations at Nix
  # build time. This eliminates 5 runtime process spawns on every interactive
  # shell startup (`dircolors`, `zoxide init`, `starship init`, `starship prompt --continuation`,
  # and `direnv hook`), saving ~90ms per shell launch without losing any behavior.
  precompiledZshIntegrations =
    pkgs.runCommand "zsh-precompiled-integrations"
      {
        nativeBuildInputs = [ pkgs.zsh ];
      }
      ''
        export HOME="$TMPDIR"
        mkdir -p "$out"
        {
          echo "# Pre-generated by Nix at build time — do not edit"
          ${pkgs.coreutils}/bin/dircolors -b "${config.home.file.".dir_colors".source}"
          echo ""
          ${config.programs.zoxide.package}/bin/zoxide init zsh
          echo ""
          ${config.programs.direnv.package}/bin/direnv hook zsh
          echo ""
          echo 'if [[ $TERM != "dumb" ]]; then'
          ${config.programs.starship.package}/bin/starship init zsh --print-full-init \
            | sed 's|^PROMPT2="\(.*\)"$|PROMPT2='\'''\1'\'''|'
          echo 'fi'
        } > "$out/integrations.zsh"
        zsh -c "zcompile '$out/integrations.zsh'"
      '';
in
{
  programs = {
    zsh = {
      enable = true;
      enableCompletion = true;
      completionInit = ''
        source "${../scripts/zsh-completion-init.zsh}"
      '';
      autosuggestion.enable = true;
      syntaxHighlighting.enable = true;

      # Explicitly set dotDir to lock in current behavior (home directory).
      dotDir = "/Users/${config.home.username}";

      sessionVariables = {
        NIX_PATH = "$HOME/.nix-defexpr/channels:$NIX_PATH";
        FPATH = "$HOME/.zsh/completion:/opt/homebrew/share/zsh/site-functions:$FPATH";
        UV_PYTHON_PREFERENCE = "managed";
        CARGO_HOME = "$HOME/.cargo";
        RUSTUP_HOME = "$HOME/.rustup";
        HOMEBREW_PREFIX = "/opt/homebrew";
        HOMEBREW_CELLAR = "/opt/homebrew/Cellar";
        HOMEBREW_REPOSITORY = "/opt/homebrew/Library/.homebrew-is-managed-by-nix";
        INFOPATH = "/opt/homebrew/share/info:\${INFOPATH:-}";
      }
      // lib.optionalAttrs bitwardenAgent.enable {
        DOTFILES_BITWARDEN_SSH_AGENT = "1";
        BITWARDEN_SSH_AUTH_SOCK = bitwardenSocketEnv;
      };

      initContent = ''
        # Deduplicate PATH and fpath entries automatically in Zsh
        typeset -U path PATH fpath FPATH

        # Static Homebrew environment (replaces `eval "$(brew shellenv)"` to save ~51ms per shell)
        export HOMEBREW_PREFIX="/opt/homebrew"
        export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
        export HOMEBREW_REPOSITORY="/opt/homebrew/Library/.homebrew-is-managed-by-nix"
        fpath=("/opt/homebrew/share/zsh/site-functions" $fpath)
        export INFOPATH="/opt/homebrew/share/info:''${INFOPATH:-}"

        # Ensure complete PATH including Nix profiles, Homebrew, and standard macOS system bins
        export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.docker/bin:$HOME/.cargo/bin:$HOME/bin:$HOME/.nix-profile/bin:/etc/profiles/per-user/$USER/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

        ${lib.optionalString bitwardenAgent.enable ''
          export DOTFILES_BITWARDEN_SSH_AGENT="1"
          export BITWARDEN_SSH_AUTH_SOCK="${bitwardenSocketEnv}"
        ''}

        source "${precompiledZshIntegrations}/integrations.zsh"
        source "${../scripts/zsh-integration.zsh}"

        ${lib.optionalString profile.isWork ''
          # Optional devcontainer-auto integration for the Work profile. The
          # hook is installed outside this repository and should not make shell
          # startup fail when absent.
          if [ -r "$HOME/.config/devcontainer-auto/zsh-hook" ]; then
            source "$HOME/.config/devcontainer-auto/zsh-hook"
          fi
        ''}

        _dotfiles_run_rebuild() {
          DOTFILE_DIR="${config.home.homeDirectory}/${userConfig.directories.dotfiles}" \
          CURRENT_CONFIG_HOST="${userConfig.hostname}" \
          bash "${../scripts/rebuild-system.sh}" "$@" || return $?
        }

        rebuild() {
          _dotfiles_run_rebuild "$@"
        }

        rebuild-work() {
          rebuild --work "$@"
        }

        rebuild-personal() {
          rebuild --personal "$@"
        }

        update() {
          DOTFILE_DIR="${config.home.homeDirectory}/${userConfig.directories.dotfiles}" \
          CURRENT_CONFIG_HOST="${userConfig.hostname}" \
          bash "${../scripts/update-system.sh}" "$@"
        }
      ''
      + lib.optionalString profile.isWork ''
        source "${../scripts/work.zsh}"
      '';

      history = {
        size = 50000;
        save = 50000;
        share = true;
        ignoreDups = true;
        ignoreSpace = true;
        expireDuplicatesFirst = true;
      };
    };

    fzf = {
      enable = true;
      enableZshIntegration = true;
    };

    zoxide = {
      enable = true;
      # Pre-compiled at Nix build time above to avoid spawning `zoxide init zsh` on every shell launch.
      enableZshIntegration = false;
    };
  };

  home = {
    enableNixpkgsReleaseCheck = false;
  };
}
