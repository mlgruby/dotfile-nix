@@ -0,0 +1,31 @@
+package markdown
+
+import (
+	"github.com/charmbracelet/x/ansi"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+	"strings"
+	"testing"
+)
+
+func TestReadableMarkdownForBothBackgrounds(t *testing.T) {
+	for _, dark := range []bool{true, false} {
+		markdownStyle = nil
+		markdownStyleSource = ""
+		renderer := GetMarkdownRenderer(70, &context.ProgramContext{HasDarkBackground: dark})
+		text, err := renderer.Render("# Heading one\n\n## Change Type\n\n### Risk\n\n#### Four\n\n##### Five\n\n###### Six\n\nUse `IOConfig` with **care**.\n\n- First item\n\n| Package | Version |\n| --- | --- |\n| library | 2.0 |\n")
+		if err != nil {
+			t.Fatal(err)
+		}
+		plain := ansi.Strip(text)
+		if strings.Contains(plain, "#") || strings.Contains(plain, "`") {
+			t.Fatalf("source markers still visible (dark=%v): %s", dark, plain)
+		}
+		for _, want := range []string{"Heading one", "Change Type", "IOConfig", "care", "First item", "Package", "library", "2.0", "│"} {
+			if !strings.Contains(plain, want) {
+				t.Fatalf("missing %q (dark=%v): %s", want, dark, plain)
+			}
+		}
+	}
+	markdownStyle = nil
+	markdownStyleSource = ""
+}
