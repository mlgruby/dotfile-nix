+package sidebar
+
+import (
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+)
+
+func TestMouseWheelScrollsSmallStepsAndClamps(t *testing.T) {
+	model := NewModel()
+	model.viewport.SetWidth(40)
+	model.viewport.SetHeight(10)
+	model.SetContent(strings.TrimSuffix(strings.Repeat("line\n", 100), "\n"))
+
+	model, _ = model.Update(tea.MouseWheelMsg{Button: tea.MouseWheelDown})
+	if model.YOffset() != 3 {
+		t.Fatalf("down: got %d, want 3", model.YOffset())
+	}
+	model, _ = model.Update(tea.MouseWheelMsg{Button: tea.MouseWheelUp})
+	if model.YOffset() != 0 {
+		t.Fatalf("up: got %d, want 0", model.YOffset())
+	}
+	for range 100 {
+		model, _ = model.Update(tea.MouseWheelMsg{Button: tea.MouseWheelDown})
+	}
+	if model.YOffset() != 90 {
+		t.Fatalf("bottom: got %d, want 90", model.YOffset())
+	}
+	model, _ = model.Update(tea.MouseWheelMsg{Button: tea.MouseWheelLeft})
+	if model.YOffset() != 90 {
+		t.Fatal("horizontal wheel changed vertical scroll")
+	}
+	for range 100 {
+		model, _ = model.Update(tea.MouseWheelMsg{Button: tea.MouseWheelUp})
+	}
+	if model.YOffset() != 0 {
+		t.Fatalf("top: got %d, want 0", model.YOffset())
+	}
+}
