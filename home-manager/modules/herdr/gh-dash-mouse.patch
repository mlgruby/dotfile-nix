+package tui
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/dlvhdr/gh-dash/v4/internal/config"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+	zone "github.com/lrstanley/bubblezone/v2"
+)
+
+func TestMouseWheelRoutesOnlyToHoveredPreview(t *testing.T) {
+	for _, position := range []string{"right", "bottom"} {
+		t.Run(position, func(t *testing.T) {
+			zone.NewGlobal()
+			zone.SetEnabled(true)
+			model := NewModel(config.Location{}, Repositories{})
+			model.sidebar.IsOpen = true
+			model.sidebar.UpdateProgramContext(&context.ProgramContext{
+				MainContentHeight: 11, DynamicPreviewHeight: 11, DynamicPreviewWidth: 40,
+				PreviewPosition: position, Styles: context.DefaultStyles,
+			})
+			model.sidebar.SetContent(strings.Repeat("line\n", 100))
+			x, y := 65, 0
+			prefix := strings.Repeat(" ", 60)
+			if position == "bottom" {
+				x, y = 5, 15
+				prefix = strings.Repeat("header\n", 15)
+			}
+			zone.Scan(prefix + zone.Mark("preview-pane", strings.Repeat("x", 40)))
+			wheel := tea.MouseWheelMsg{X: x, Y: y, Button: tea.MouseWheelDown}
+			// Bubblezone publishes scanned bounds on its worker goroutine.
+			deadline := time.Now().Add(time.Second)
+			for !zone.Get("preview-pane").InBounds(wheel) {
+				if time.Now().After(deadline) {
+					t.Fatal("preview bounds were not published")
+				}
+				time.Sleep(time.Millisecond)
+			}
+			model.Update(wheel)
+			if model.sidebar.YOffset() != 3 {
+				t.Fatalf("hovered preview did not scroll: %d", model.sidebar.YOffset())
+			}
+			model.Update(tea.MouseWheelMsg{X: 1, Y: 1, Button: tea.MouseWheelDown})
+			if model.sidebar.YOffset() != 3 {
+				t.Fatal("wheel outside preview moved preview")
+			}
+			model.sidebar.IsOpen = false
+			model.Update(wheel)
+			if model.sidebar.YOffset() != 3 {
+				t.Fatal("closed preview moved")
+			}
+		})
+	}
+}
