# Google AI Studio / Gemini API key. Never commit the real value.
GEMINI_API_KEY=replace-me

# Graphify Streamable HTTP MCP endpoint.
# GRAPHIFY_API_KEY is only needed if the Graphify server was started with --api-key.
GRAPHIFY_MCP_URL=http://graphify-mcp:8080/mcp
# GRAPHIFY_API_KEY=

PI_MODEL=gemini-3.6-flash
PORT=8080
